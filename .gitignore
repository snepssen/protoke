.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!.env.example

# Generated media and training artifacts
*.wav
*.wave
*.flac
*.mp3
*.m4a
*.aiff
*.ogg
*.mp4
*.mov
*.ass
*.srt
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
checkpoints/
models/
runs/
exports/
samples/
cache/
logs/
*.log
*.pid

# The project page's own demo clip is published on purpose — the one exception
# to the media rules above, and it has to come after them because gitignore
# takes the last matching rule. scripts/check_release.py enforces the same
# narrow allowance, with a size budget.
!docs/*.mp4
!docs/*.webm

# Generated corpora and reports
clips/
held-back/
metadata.csv
manifest.tsv
beat-analysis/
groundtruth/
tensors/

# Voice training corpus lives outside the repo entirely, at
# ~/Claude/voice-training-data/. These entries are a second line of
# defense in case any of it is ever copied or symlinked back in.
voice-corpus/
voice-corpus-rode/
Voice-beta-rode/
from-deck/
media/
